<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="org.example.ca2.app.MainController">

    <Tab closable="false" text="Graph Routes">
        <VBox spacing="8">

            <HBox spacing="10">
                <Label text="Start:" />
                <ComboBox fx:id="startRoomComboBox" prefWidth="160" promptText="Start Room" />

                <Label text="Destination:" />
                <ComboBox fx:id="endRoomComboBox" prefWidth="160" promptText="Destination Room" />

                <Button onAction="#handleDijkstraRoute" text="Dijkstra Route" />
                <Button onAction="#handleDFSRoute" text="DFS Route" />
            </HBox>

            <HBox spacing="10">
                <Label text="Avoid room:" />
                <ComboBox fx:id="avoidRoomComboBox" prefWidth="160" promptText="Room to avoid" />
                <Button onAction="#handleAddAvoidRoom" text="Add Avoid" />
                <Button onAction="#handleClearAvoidRooms" text="Clear Avoid" />

                <Label text="Waypoint:" />
                <ComboBox fx:id="waypointRoomComboBox" prefWidth="160" promptText="Must visit room" />
                <Button onAction="#handleAddWaypoint" text="Add Waypoint" />
                <Button onAction="#handleClearWaypoints" text="Clear Waypoints" />
            </HBox>

            <HBox spacing="10">
                <VBox>
                    <Label text="Avoid rooms:" />
                    <ListView fx:id="avoidRoomsListView" prefHeight="90" prefWidth="220" />
                </VBox>

                <VBox>
                    <Label text="Waypoints:" />
                    <ListView fx:id="waypointRoomsListView" prefHeight="90" prefWidth="220" />
                </VBox>
            <TextArea fx:id="informationField" prefHeight="91.0" prefWidth="829.0" />
            </HBox>

            <ScrollPane pannable="true">
                <Group fx:id="colourMapGroup">
                    <ImageView fx:id="colourMapImageView" />
                    <Pane fx:id="graphOverlayPane" />
                </Group>
            </ScrollPane>

        </VBox>
    </Tab>

    <Tab closable="false" text="BFS Pixel Route">
        <VBox spacing="8">

            <HBox spacing="10">
                <Label text="Click once for start, click again for destination." />
                <Button onAction="#handleClearBFSRoute" text="Clear BFS Route" />
            </HBox>
         <TextArea fx:id="informationBFS" prefHeight="43.0" prefWidth="697.0" />

            <ScrollPane pannable="true">
                <Group fx:id="bwMapGroup">
                    <ImageView fx:id="bwMapImageView" />
                    <Pane fx:id="bfsOverlayPane" />
                </Group>
            </ScrollPane>

        </VBox>
    </Tab>

</TabPane>
